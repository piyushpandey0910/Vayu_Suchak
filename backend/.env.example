# Vayu Suchak Backend Environment Configuration

# API Keys (Stored only on the backend, NEVER exposed to frontend)
# World Air Quality Index (WAQI) token: https://aqicn.org/data-platform/token/
WAQI_API_KEY=

# OpenAQ API Key: https://openaq.org/
OPENAQ_API_KEY=

# LLM Provider Key (Google Gemini API key or OpenAI)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Database Configuration
DATABASE_URL=sqlite:///./vayu_suchak.db

# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Rate Limiting Defaults
RATE_LIMIT_AI_CHAT_MINUTE=10
RATE_LIMIT_AI_CHAT_DAY=100
RATE_LIMIT_FORECAST_MINUTE=30
RATE_LIMIT_GENERAL_MINUTE=60
