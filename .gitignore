# ==========================================
# Vayu Suchak - .gitignore for GitHub
# ==========================================

# Environment variables & API keys (NEVER commit secrets to Git)
.env
*.env
.env.local
.env.*.local
!.env.example

# Node / Frontend dependencies & builds
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python compiled bytecode & cache
__pycache__/
backend/**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Python virtual environments
venv/
.venv/
env/
ENV/
backend/venv/

# SQLite databases (local dev data)
*.db
*.sqlite
*.sqlite3
vayu_suchak.db
vayu_suchak.db-journal
backend/vayu_suchak.db
backend/vayu_suchak.db-journal

# Testing & code coverage
.pytest_cache/
.coverage
htmlcov/
*.coverage.*

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
